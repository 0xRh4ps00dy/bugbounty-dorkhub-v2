{
  "manifest_version": 3,
  "name": "Search URL Extractor",
  "version": "1.1",
  "description": "Extrae URLs de resultados de búsqueda en Google y DuckDuckGo",
  "permissions": [
    "activeTab",
    "clipboardWrite",
    "tabs"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Search URL Extractor",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "commands": {
    "extract-urls": {
      "suggested_key": {
        "default": "Ctrl+Shift+U",
        "mac": "Command+Shift+U"
      },
      "description": "Extraer URLs de Google o DuckDuckGo"
    }
  },
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.google.com/search*",
        "*://google.com/search*",
        "*://duckduckgo.com/*",
        "*://*.duckduckgo.com/*",
        "*://duck.com/*",
        "*://*.duck.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
