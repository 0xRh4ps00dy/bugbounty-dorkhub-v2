{
  "manifest_version": 3,
  "name": "Search URL Extractor",
  "version": "1.3",
  "description": "Extrae URLs de resultados de búsqueda en Google y DuckDuckGo",

  "browser_specific_settings": {
    "gecko": {
      "id": "google-url-extractor@example.com",
      "strict_min_version": "109.0",
      "data_collection_permissions": {
        "required": ["none"],
        "optional": []
      }
    }
  },

  "permissions": [
    "activeTab",
    "clipboardWrite",
    "tabs"
  ],

  "background": {
    "scripts": ["background.js"]
  },

  "action": {
    "default_popup": "popup.html",
    "default_title": "Search URL Extractor",
    "default_icon": {
      "16": "icon16.png",
      "64": "icon48.png",
      "128": "icon128.png"
    }
  },

  "commands": {
    "extract-urls": {
      "suggested_key": {
        "default": "Ctrl+Alt+A",
        "mac": "Command+Shift+E"
      },
      "description": "Extraer URLs de Google o DuckDuckGo"
    }
  },

  "icons": {
    "16": "icon16.png",
    "64": "icon48.png",
    "128": "icon128.png"
  },

  "content_scripts": [
    {
      "matches": [
        "*://*.google.com/search*",
        "*://google.com/search*",
        "*://duckduckgo.com/*",
        "*://*.duckduckgo.com/*",
        "*://duck.com/*",
        "*://*.duck.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}